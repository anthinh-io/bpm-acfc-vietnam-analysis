  <diagram name="bpmn-kho-van-hanh-k1-k2-k3" id="OYZT39xQnTAZ4X2tAdn3">
    <mxGraphModel dx="2603" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
